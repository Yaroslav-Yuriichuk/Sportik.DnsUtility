<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.11" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.11" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json" />
    </ItemGroup>

    <PropertyGroup>
        <CertificateThumbprint>3E4D0540BFD18A3C8DB8998C7E2E37374C8B6E40</CertificateThumbprint>
        <SignToolPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe</SignToolPath>
    </PropertyGroup>

    <Target Name="SignApp" AfterTargets="Publish" Condition="'$(CertificateThumbprint)' != ''">
        <Exec Command="&quot;$(SignToolPath)&quot; sign /fd sha256 /sha1 $(CertificateThumbprint) /tr http://timestamp.sectigo.com /td sha256 &quot;$(PublishDir)$(AssemblyName).exe&quot;" />
    </Target>

</Project>
